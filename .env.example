# 收集App 配置示例 —— 复制为 .env 后按需修改（.env 已被 .gitignore 排除）
# 全部为可选项，留空即用代码内默认值。

# ── 身份模式 ──
# single = 本机免登录单用户（默认）；multi = 多用户注册登录（服务器部署用）
AUTH_MODE=single

# ── 服务监听 ──
# 127.0.0.1=仅本机访问；0.0.0.0=开放局域网/容器访问（手机同 WiFi 可连，启动时打印局域网地址）
HOST=127.0.0.1
# 端口默认 8770；与原笔记台 server 冲突时可改（如 8771）
PORT=8770

# ── 数据路径 ──（留空则用仓库内 data/ 与 fulltext/）
# DB_PATH=/绝对路径/data/collect.db
# FULLTEXT_DIR=/绝对路径/fulltext

# ── claude CLI 路径 ──
# 留空则自动 PATH 探测 claude；找不到则接入助手优雅降级（agent_available=False）
CLAUDE_BIN=

# ── 默认 AI 通道 ──（用户级配置优先于此实例级默认）
# channel：cli（本机 claude CLI）/ anthropic（官方 API）/ openai（OpenAI 兼容任意端点）
DEFAULT_AI_CHANNEL=cli
# openai 兼容端点地址（DeepSeek/Kimi/Ollama 等），cli/anthropic 通道留空
DEFAULT_AI_BASE_URL=
# API key（cli 通道不需要）
DEFAULT_AI_API_KEY=
# 模型名
DEFAULT_AI_MODEL=claude-sonnet-4-6

# ── 编辑部增强（本机可选）──
# 配了且本机存在 编辑部/采集.py 时，打星抓全文优先走它（playwright 兜底），失败回落内置
# EDITORIAL_ROOT=/Users/edy/Desktop/自动化文案发布全流程

# ── 多用户相关 ──
# 是否允许注册新用户（multi 模式）
ALLOW_REGISTER=true
# 会话/加密密钥（multi 部署务必设一个随机长串；single 模式可留空）
SECRET_KEY=
# session cookie 是否加 Secure 标志：HTTPS 部署时设 true（默认 false，本机 http 用）
COOKIE_SECURE=false
